<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lazyproto</groupId>
        <artifactId>lazy-proto-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lazy-proto-benchmarks</artifactId>
    <packaging>jar</packaging>
    <name>lazy-proto-benchmarks</name>
    <description>Cross-validation oracle tests, stateful model-checking fuzzers, eager baselines, and JMH benchmark suite</description>

    <properties>
        <quickbuf.version>1.4</quickbuf.version>
        <lightproto.version>0.9.3</lightproto.version>
        <netty.version>4.1.115.Final</netty.version>
        <jmh.version>1.37</jmh.version>
        <quickbuf.filename>protoc-gen-quickbuf</quickbuf.filename>
    </properties>

    <profiles>
        <profile>
            <id>quickbuf-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <quickbuf.filename>protoc-gen-quickbuf.exe</quickbuf.filename>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.lazyproto</groupId>
            <artifactId>lazy-proto-compat</artifactId>
        </dependency>
        <dependency>
            <groupId>us.hebi.quickbuf</groupId>
            <artifactId>quickbuf-runtime</artifactId>
            <version>${quickbuf.version}</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generate LightProto 0.9.3 classes from src/main/proto -->
            <plugin>
                <groupId>io.streamnative.lightproto</groupId>
                <artifactId>lightproto-maven-plugin</artifactId>
                <version>${lightproto.version}</version>
                <configuration>
                    <classPrefix>Lp</classPrefix>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Fetch platform-matched protoc 3.25.5 & protoc-gen-quickbuf 1.4 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-protoc</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.google.protobuf</groupId>
                                    <artifactId>protoc</artifactId>
                                    <version>${protobuf.version}</version>
                                    <classifier>${protoc.classifier}</classifier>
                                    <type>exe</type>
                                    <outputDirectory>${project.build.directory}/protoc</outputDirectory>
                                    <destFileName>${protoc.filename}</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>us.hebi.quickbuf</groupId>
                                    <artifactId>protoc-gen-quickbuf</artifactId>
                                    <version>${quickbuf.version}</version>
                                    <classifier>${protoc.classifier}</classifier>
                                    <type>exe</type>
                                    <outputDirectory>${project.build.directory}/protoc</outputDirectory>
                                    <destFileName>${quickbuf.filename}</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>prepare-proto-out-dir</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${protoc.mkdir.cmd}</executable>
                            <arguments>
                                <argument>${protoc.mkdir.arg1}</argument>
                                <argument>${protoc.mkdir.arg2}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>chmod-protoc</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${protoc.skip.chmod}</skip>
                            <executable>chmod</executable>
                            <arguments>
                                <argument>+x</argument>
                                <argument>${project.build.directory}/protoc/${protoc.filename}</argument>
                                <argument>${project.build.directory}/protoc/${quickbuf.filename}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-official-protobuf-java</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.build.directory}/protoc/${protoc.filename}</executable>
                            <arguments>
                                <argument>--proto_path=${project.basedir}/../proto</argument>
                                <argument>--java_out=${project.build.directory}/generated-test-sources/protobuf/java</argument>
                                <argument>${project.basedir}/../proto/order_envelope.proto</argument>
                                <argument>${project.basedir}/../proto/open_benchmarks.proto</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-quickbuf-java</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.build.directory}/protoc/${protoc.filename}</executable>
                            <arguments>
                                <argument>--plugin=protoc-gen-quickbuf=${project.build.directory}/protoc/${quickbuf.filename}</argument>
                                <argument>--proto_path=${project.basedir}/proto-quickbuf</argument>
                                <argument>--quickbuf_out=allocation=lazy:${project.build.directory}/generated-test-sources/protobuf/java</argument>
                                <argument>${project.basedir}/proto-quickbuf/quickbuf_order_envelope.proto</argument>
                                <argument>${project.basedir}/proto-quickbuf/quickbuf_open_benchmarks.proto</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-generated-proto-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/protobuf/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Suite.java</include>
                    </includes>
                    <excludedGroups>benchmark</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
