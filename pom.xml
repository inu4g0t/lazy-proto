<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.lazyproto</groupId>
    <artifactId>lazy-proto</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>lazy-proto</name>
    <description>Performance-first lazy deserialization and input-reusing splicing serialization for Protocol Buffers in Java</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <protobuf.version>3.25.5</protobuf.version>
        <junit.version>5.10.2</junit.version>
        <protoc.classifier>linux-x86_64</protoc.classifier>
        <protoc.filename>protoc</protoc.filename>
        <protoc.skip.chmod>false</protoc.skip.chmod>
        <protoc.mkdir.cmd>sh</protoc.mkdir.cmd>
        <protoc.mkdir.arg1>-c</protoc.mkdir.arg1>
        <protoc.mkdir.arg2>mkdir -p "${project.build.directory}/generated-test-sources/protobuf/java"</protoc.mkdir.arg2>
    </properties>

    <profiles>
        <profile>
            <id>os-linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>linux-x86_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>linux-aarch_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-mac-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>osx-x86_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>osx-aarch_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-windows-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>windows-x86_64</protoc.classifier>
                <protoc.filename>protoc.exe</protoc.filename>
                <protoc.skip.chmod>true</protoc.skip.chmod>
                <protoc.mkdir.cmd>cmd</protoc.mkdir.cmd>
                <protoc.mkdir.arg1>/c</protoc.mkdir.arg1>
                <protoc.mkdir.arg2>if not exist "${project.build.directory}\generated-test-sources\protobuf\java" mkdir "${project.build.directory}\generated-test-sources\protobuf\java"</protoc.mkdir.arg2>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- Official Google Protobuf runtime for interface compatibility (Intermediate Layer) & protoc baseline comparison -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <!-- JUnit 5 for correctness & benchmark suite -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fetch platform-matched protoc 3.25.5 matching protobuf-java 3.25.5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-protoc</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.google.protobuf</groupId>
                                    <artifactId>protoc</artifactId>
                                    <version>${protobuf.version}</version>
                                    <classifier>${protoc.classifier}</classifier>
                                    <type>exe</type>
                                    <outputDirectory>${project.build.directory}/protoc</outputDirectory>
                                    <destFileName>${protoc.filename}</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>prepare-proto-out-dir</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${protoc.mkdir.cmd}</executable>
                            <arguments>
                                <argument>${protoc.mkdir.arg1}</argument>
                                <argument>${protoc.mkdir.arg2}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>chmod-protoc</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${protoc.skip.chmod}</skip>
                            <executable>chmod</executable>
                            <arguments>
                                <argument>+x</argument>
                                <argument>${project.build.directory}/protoc/${protoc.filename}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-official-protobuf-java</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.build.directory}/protoc/${protoc.filename}</executable>
                            <arguments>
                                <argument>--proto_path=${project.basedir}/proto</argument>
                                <argument>--java_out=${project.build.directory}/generated-test-sources/protobuf/java</argument>
                                <argument>${project.basedir}/proto/order_envelope.proto</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-generated-proto-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/protobuf/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Suite.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
