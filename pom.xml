<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.lazyproto</groupId>
    <artifactId>lazy-proto-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>lazy-proto-parent</name>
    <description>Performance-first lazy deserialization and input-reusing splicing serialization for Protocol Buffers</description>

    <modules>
        <module>lazy-proto-core</module>
        <module>lazy-proto-compat</module>
        <module>lazy-proto-benchmarks</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <protobuf.version>3.25.5</protobuf.version>
        <junit.version>5.10.2</junit.version>
        <protoc.classifier>linux-x86_64</protoc.classifier>
        <protoc.filename>protoc</protoc.filename>
        <protoc.skip.chmod>false</protoc.skip.chmod>
        <protoc.mkdir.cmd>sh</protoc.mkdir.cmd>
        <protoc.mkdir.arg1>-c</protoc.mkdir.arg1>
        <protoc.mkdir.arg2>mkdir -p "${project.build.directory}/generated-test-sources/protobuf/java"</protoc.mkdir.arg2>
    </properties>

    <profiles>
        <profile>
            <id>os-linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>linux-x86_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>linux-aarch_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-mac-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>osx-x86_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>osx-aarch_64</protoc.classifier>
            </properties>
        </profile>
        <profile>
            <id>os-windows-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <protoc.classifier>windows-x86_64</protoc.classifier>
                <protoc.filename>protoc.exe</protoc.filename>
                <protoc.skip.chmod>true</protoc.skip.chmod>
                <protoc.mkdir.cmd>cmd</protoc.mkdir.cmd>
                <protoc.mkdir.arg1>/c</protoc.mkdir.arg1>
                <protoc.mkdir.arg2>if not exist "${project.build.directory}\generated-test-sources\protobuf\java" mkdir "${project.build.directory}\generated-test-sources\protobuf\java"</protoc.mkdir.arg2>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.lazyproto</groupId>
                <artifactId>lazy-proto-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lazyproto</groupId>
                <artifactId>lazy-proto-compat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
